# Copy to .env and adjust. Every value here has a working default for the
# local, project-local Postgres instance started by `scripts/db.sh start`.

# Async SQLAlchemy URL used by the app.
DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5433/hiring

# Separate database used by the test suite. Tests truncate it freely.
TEST_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5433/hiring_test

# --- Search LLM fallback -------------------------------------------------
# OPTIONAL. The rule-based parser handles every documented query with no API
# call. This key is only used when a query is so ambiguous that the rules
# cannot parse it at all. With it unset, such queries return the 422
# "couldn't understand this query" contract instead of a guess -- the app is
# fully functional without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Set to false to disable the fallback even when a key is present. Useful in
# CI so no test ever depends on the network.
SEARCH_LLM_FALLBACK_ENABLED=true

# Per-request timeout, in seconds, for the LLM fallback call.
SEARCH_LLM_TIMEOUT_SECONDS=8
